# Interactive VLM Feedback Loop — Application Configuration
#
# Non-secret application settings. Copy this file to
# ~/.vlm_feedback_loop/config.yaml (or run `vlm-feedback-loop init` to
# generate a commented equivalent covering every setting), then
# uncomment values you want to override. Anything not set here falls
# back to the built-in defaults in
# src/backend/vlm_feedback_loop/_defaults.py — a commented line keeps
# tracking the shipped default across upgrades; an uncommented line
# pins the value written here.
#
# Secrets (NVIDIA_API_KEY, NGC_API_KEY, TAO_API_KEY, TAO workspace S3
# credentials, and HF_TOKEN) belong in .env, NOT here. See .env.example for
# the secrets template. Non-secret TAO runtime settings remain in this file.
#
# Configuration precedence (Engineering_Spec §1.9):
#   1. Process environment variables
#   2. Explicit --env-file or VLM_FEEDBACK_LOOP_ENV_FILE
#   3. ~/.vlm_feedback_loop/.env
#   4. ~/.vlm_feedback_loop/config.yaml  ← this file
#   5. Built-in defaults

# ── Workspace ──────────────────────────────────────────────
# Absolute path where project data is stored (databases, exports,
# artifacts, logs). REQUIRED — no built-in default.
WORKSPACE_ROOT: /path/to/workspace

# ── Logging ────────────────────────────────────────────────
# 'info' (default) or 'debug' for ICL/token-budget/selector decision
# traces during development.
# LOG_LEVEL: info

# ── Server bind ────────────────────────────────────────────
# Loopback by default. When BIND_HOST is non-loopback, IMAGE_ROOT
# MUST be set to one absolute directory (Spec §12.2).
# BIND_HOST: 127.0.0.1
# BIND_PORT: 8000
# IMAGE_ROOT:
# When unset on loopback, the filesystem is unrestricted; Ingest starts beside
# the bundled sample when it is present. To restrict browsing while keeping the
# sample directory itself selectable, configure its parent:
# IMAGE_ROOT: /absolute/path/to/vlm-feedback-loop/deploy

# ── Hosted NIM ─────────────────────────────────────────────
# HOSTED_NIM_BASE_URL: https://integrate.api.nvidia.com/v1

# ── Image transport ────────────────────────────────────────
# Max longest edge (pixels) for images transmitted to models. Larger
# source images are downscaled (aspect-preserving, LANCZOS) before
# base64 encoding; stored originals, exports, and training data are
# never modified. Default 2090 = the high-detail visual-budget geometry
# for 4:3 images, which a 7-model acuity study found at-or-above the
# perception ceiling of most hosted teachers, while keeping worst-case
# 8-image ICL payloads inside hosted-provider gateway limits (full-res
# phone photos otherwise 504 at the provider edge on some models).
# Set 0 to disable (send source images as-is).
# IMAGE_TRANSPORT_MAX_LONGEST_EDGE: 2090

# ── Local NIM ports ────────────────────────────────────────
# Preferred host ports for locally deployed NIM containers. The teacher
# default (8000) collides with the backend's own BIND_PORT default when
# both run on one box; the deploy flow probes the preferred port and
# auto-bumps to the next available one, so the collision resolves itself.
# Set an explicit free port here to make placement deterministic.
# LOCAL_NIM_TEACHER_PORT: 8000
# LOCAL_NIM_NVCLIP_PORT: 8001

# ── New-project defaults ───────────────────────────────────
# What model gets seeded as the Teacher on freshly-created projects.
# Built-in default is hosted Step 3.7 Flash — works on any machine with
# NVIDIA_API_KEY set, no GPU required, and its published model terms permit
# commercial use. NVIDIA's free API Catalog endpoint remains for development
# and evaluation; production requires a subscribed provider endpoint or an
# appropriately entitled self-hosted NIM.
#
# DEFAULT_TEACHER_MODEL: stepfun-ai/step-3.7-flash
# DEFAULT_TEACHER_LOCAL_BASE_URL: null
#
# To use a locally-deployed Teacher NIM (e.g. on a GPU rental with
# cosmos-reason2-8b running on port 8001), uncomment the block below. At
# project-creation time the backend will probe the URL's /health/ready
# and rebind the Teacher's model_config to a freshly-seeded self_hosted
# endpoint — required because the hosted catalog at build.nvidia.com
# doesn't currently serve cosmos-reason2-8b.
#
# DEFAULT_TEACHER_MODEL: nvidia/cosmos-reason2-8b
# DEFAULT_TEACHER_LOCAL_BASE_URL: http://127.0.0.1:8001/v1

# ── UI secret persistence ──────────────────────────────────
# When true (default), an API key pasted in the NIM Configuration UI may
# be persisted to ~/.vlm_feedback_loop/.env (written 0600). Set false
# where .env is managed externally — keys pasted in the UI then apply
# for the process lifetime only. The shipped docker-compose.yml sets
# this false via process env (the in-container .env is ephemeral).
# ALLOW_UI_SECRET_PERSIST: true

# ── Embedding model identity (see Engineering Spec §5.5) ─────
# The supported Blueprint model is NVIDIA NeMo Retriever VL 1B v2 (2048-dim).
# Advanced replacements must expose the same OpenAI-compatible embeddings API;
# the system-managed local launch profile supports only the shipped model.
# EMBEDDING_MODEL_ID: nvidia/llama-nemotron-embed-vl-1b-v2
# EMBEDDING_DIM: 2048

# ── Foreground-priority dispatch hold ─────────────────────────
# true (default): an in-flight interactive proposal (the SME clicking
# through Review) holds NEW background HTTP dispatches (evaluation /
# batch-label traffic) so the human never queues behind batch work.
# Set false for batch/AutoRun-driven campaigns: a continuous AutoRun
# proposal stream otherwise starves background evaluation dispatch
# indefinitely (process-global gate).
# FOREGROUND_HOLD_ENABLED: true

# ── Student training ───────────────────────────────────────
# TAO's stale-heartbeat reaper kills quiet jobs after 60 minutes when no
# per-job timeout is supplied. cosmos-rl does not emit a heartbeat while it
# trains, so the Blueprint sends this generous 24-hour ceiling on every
# training-suite job. It is a dead-job backstop, not an ETA; increase it for
# unusually long runs. Student Training preflight fails closed if the TAO v2
# API does not support this field (install guide §13.15).
# TAO_JOB_TIMEOUT_MINUTES: 1440

# ── Complete advanced tuning catalog ─────────────────────
# The settings below are normally left commented. They are included so this
# public sample remains a complete, searchable map of every supported
# non-secret setting. Uncomment only the narrow value you intentionally want
# to pin; otherwise the Blueprint continues to inherit the release default.

# Embedding lifecycle and request shape (concurrency and batch sizes must be >= 1)
# EMBEDDING_PROVIDER: auto
# EMBEDDING_INPUT_TYPE: passage
# EMBEDDINGS_AUTO_COMPUTE: true
# EMBEDDING_CONCURRENCY_HOSTED: 1
# EMBEDDING_BATCH_SIZE_HOSTED: 8
# EMBEDDING_CONCURRENCY_SELF_HOSTED: 4
# EMBEDDING_BATCH_SIZE_SELF_HOSTED: 1

# Proposal generation and visual-budget tables
# THINKING_DEFAULT_ON: true
# LABELING_PRESETS:
#   precise:
#     temperature: 0.0
#     top_p: 1.0
#   explore:
#     temperature: 0.3
#     top_p: 0.9
# VISUAL_BUDGET_PRESETS:
#   native: {}
#   fast:
#     mm_processor_size:
#       size:
#         shortest_edge: 1568
#         longest_edge: 65536
#     mm_processor_pixels:
#       images_kwargs:
#         min_pixels: 1568
#         max_pixels: 65536
#     mm_processor_tiles:
#       max_num_tiles: 8
#   balanced:
#     mm_processor_size:
#       size:
#         shortest_edge: 1568
#         longest_edge: 131072
#     mm_processor_pixels:
#       images_kwargs:
#         min_pixels: 1568
#         max_pixels: 131072
#     mm_processor_tiles:
#       max_num_tiles: 16
#   high_detail:
#     mm_processor_size:
#       size:
#         shortest_edge: 1568
#         longest_edge: 262144
#     mm_processor_pixels:
#       images_kwargs:
#         min_pixels: 1568
#         max_pixels: 262144
#     mm_processor_tiles:
#       max_num_tiles: 32
# RUNTIME_PROMPT_OUTPUT_MAX_TOKENS_OVERRIDE: null
# RUNTIME_PROMPT_TOKEN_SAFETY_MARGIN: 0.85
# BASE_OUTPUT_TOKENS_FLOOR: 256
# JSON_STRUCTURAL_OVERHEAD_TOKENS: 48
# MAX_OUTPUT_FRACTION: 0.25
# RATIONALE_NOTE_ESTIMATE_TOKENS: 160
# DEFAULT_UNBOUNDED_STRING_BUDGET: 200
# MODEL_REASONING_HEADROOM_TOKENS: 16384
# Token counts must be positive (structural overhead may be zero); fractions
# and the safety margin must be > 0 and <= 1. Reasoning headroom must be >= 4096.

# ICL, evaluation, and batch dispatch
# ICL maximum may be null; when set, it must be >= 1.
# ICL_MAX_EXAMPLES: null
# ICL_SIM_GAP: 0.05
# ICL_ABS_THRESHOLD: null
# Batch run limit may be null; when set, it and the breaker threshold must be >= 1.
# BATCH_LABEL_RUN_LIMIT: null
# BATCH_LABEL_CIRCUIT_BREAKER_THRESHOLD: 10
# Dispatch concurrencies must be >= 1.
# BATCH_LABEL_CONCURRENCY_HOSTED: 1
# BATCH_LABEL_CONCURRENCY_SELF_HOSTED: 8
# EVAL_CONCURRENCY_HOSTED: 1
# EVAL_CONCURRENCY_SELF_HOSTED: 8
# EVAL_FIRST_POOL_SIZE: 5
# EVAL_RATE_LIMIT_RETRY_MAX_PASSES: 4
# EVAL_RATE_LIMIT_RETRY_BACKOFF_S: 30
# HOSTED_GLOBAL_RPM: 0
# ENABLE_THINKING_TOGGLE_FALLBACK: true
# ENABLE_VISUAL_BUDGET_FALLBACK: true

# Student training and local serving (timeouts and each concurrency must be >= 1)
# TAO_RELEASE_VERSION: 6.26.3
# COSMOS_RL_CONTAINER_TAG: 6.26.3-cosmos-rl
# TAO_QUANTIZATION_CALIBRATION_SAMPLES: 128
# STUDENT_QUALITY_PARTIAL_PARSEABLE_THRESHOLD: 0.9
# MERGE_LORA_PYTHON: null
# NIM_STARTUP_TIMEOUT_S: 1200
# NIM_BENCHMARK_TIMEOUT_S: 1200
# STUDENT_LATENCY_TEST_CONCURRENCIES:
# - 1
# - 8
# - 24
# NIM_GPU_MEMORY_8B_BF16_GB: 56
# NIM_GPU_MEMORY_8B_FP8_GB: 48
# NIM_GPU_MEMORY_2B_BF16_GB: 36
# NIM_GPU_MEMORY_2B_FP8_GB: 24
# NIM_STUDENT_PORT: 8002

# Review selection and schema reminders
# REVIEW_SELECTION_MODE: auto
# REVIEW_RECENT_WINDOW_K: 20
# CLIP_SWITCHOVER_MIN_COUNT: 50
# SCHEMA_REFINEMENT_REMINDER_THRESHOLD_1: 10
# SCHEMA_REFINEMENT_REMINDER_THRESHOLD_2: 35

# HTTP deadlines and TAO reconciliation cadence (deadlines/attempts must be >= 1)
# HTTP_DEADLINE_INTERACTIVE_S: 180
# HTTP_DEADLINE_BACKGROUND_S: 300
# HTTP_MAX_RETRIES: 3
# TAO_POLL_MIN_INTERVAL_S: 30
# TAO_POLL_MIN_INTERVAL_RUNNING_S: 60
# TAO_POLL_TICK_S: 10
# TAO_AUTOEVAL_SKIP_BASES:
# - nvidia/cosmos-reason2-8b
# - nvidia/cosmos3-nano-reasoner
# - nvidia/cosmos3-super-reasoner
